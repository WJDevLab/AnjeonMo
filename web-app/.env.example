# 앱 이름은 확정 후 app/config/app.ts의 APP_NAME에서 설정합니다.

# 헬멧 Web Bluetooth
NEXT_PUBLIC_HELMET_BLE_SERVICE_UUID=
NEXT_PUBLIC_HELMET_BLE_CHARACTERISTIC_UUID=

# 데크 Wi-Fi 게이트웨이 WebSocket
NEXT_PUBLIC_DECK_WS_URL=

# 하드웨어 팀과 전송 주기를 합의한 뒤 설정합니다.
NEXT_PUBLIC_HELMET_STALE_AFTER_MS=
NEXT_PUBLIC_DECK_STALE_AFTER_MS=

# 실제 거리·요금·주행 상태 스트림
NEXT_PUBLIC_RIDE_WS_URL=

# 로컬 상태 테스트 전용. 제출 또는 운영 환경에서는 false로 유지합니다.
NEXT_PUBLIC_ENABLE_SENSOR_SCENARIOS=false
